{
  "manifest_version": 3,
  "name": "Local Audio Control — Яндекс Музыка",
  "version": "1.1.0",
  "description": "Передаёт команду «Следующий трек» из Local Audio Control в веб-плеер Яндекс Музыки.",
  "minimum_chrome_version": "121",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "https://music.yandex.ru/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.yandex.ru/*"
      ],
      "js": [
        "player.js"
      ]
    }
  ]
}
